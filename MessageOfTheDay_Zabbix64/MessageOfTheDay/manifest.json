{
    "manifest_version": 2.0,
    "id": "message-of-the-day",
    "name": "Message of the Day",
    "version": "1.0",
    "namespace": "MessageOfTheDay",
    "description": "Display a configurable banner message to all users on every page.",
    "actions": {
        "messageoftheday.edit": {
            "class": "MessageOfTheDayEdit",
            "view": "messageoftheday.edit"
        },
        "messageoftheday.save": {
            "class": "MessageOfTheDaySave"
        },
        "messageoftheday.config": {
            "class": "MessageOfTheDayConfig"
        }
    },
    "assets": {
        "css": ["motd.banner.css"],
        "js": ["motd.banner.js"]
    }
}
